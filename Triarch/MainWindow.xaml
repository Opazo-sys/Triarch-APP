                <ListBox Name="StressLog" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}" />
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
