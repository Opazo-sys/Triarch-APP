<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Triarch.SensorMonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Triarch · Monitor de Sensores (2ª Tela)" Width="980" Height="720" MinWidth="540" MinHeight="420" Background="#00FFFFFF" Foreground="{DynamicResource Fg}" FontFamily="{StaticResource Sans}" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border Name="Root" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusWindow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="16,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Text="TRIARCH" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="{DynamicResource Faint}" Margin="8,0" VerticalAlignment="Center" />
          <TextBlock Text="MONITOR DE SENSORES (2ª TELA)" Foreground="{DynamicResource Muted}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" Padding="14,5" WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FPS " FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            <TextBlock Name="TopFps" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentHover}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
            <Border Width="1" Height="12" Background="{DynamicResource LineStrong}" Margin="12,0" />
            <TextBlock Text="CPU " FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            <TextBlock Name="TopCpuTemp" Text="—" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
            <TextBlock Name="TopCpuLoad" Text="" FontSize="11" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" Margin="6,0,0,0" VerticalAlignment="Center" />
            <Border Width="1" Height="12" Background="{DynamicResource LineStrong}" Margin="12,0" />
            <TextBlock Text="GPU " FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            <TextBlock Name="TopGpuTemp" Text="—" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
            <TextBlock Name="TopGpuLoad" Text="" FontSize="11" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <CheckBox Name="ChkTopmost" Content="Sempre no topo" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkTopmost_Click" />
          <Button Style="{StaticResource CaptionButton}" Content="" ToolTip="Minimizar" Click="Min_Click" />
          <Button Name="BtnMax" Style="{StaticResource CaptionButton}" Content="" ToolTip="Maximizar" Click="Max_Click" />
          <Button Style="{StaticResource CloseButton}" Content="" ToolTip="Fechar monitor" Click="Close_Click" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="14,0,14,10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,12">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="HARDWARE VISÍVEL (ESTILO HWMONITOR)" Style="{StaticResource Label}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <Button Style="{StaticResource OutlineButton}" Content="SÓ CPU + GPU" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="PresetCpuGpu_Click" />
              <Button Style="{StaticResource OutlineButton}" Content="MOSTRAR TUDO" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="PresetAll_Click" />
              <Button Style="{StaticResource OutlineButton}" Content="ZERAR MÍN/MÁX" Padding="10,4" FontSize="11" Click="ResetMinMax_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="COLUNAS:" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <RadioButton Name="Col1" Style="{StaticResource Chip}" GroupName="Cols" Content="1" Tag="1" Checked="Col_Checked" />
              <RadioButton Name="Col2" Style="{StaticResource Chip}" GroupName="Cols" Content="2" Tag="2" IsChecked="True" Checked="Col_Checked" />
              <RadioButton Name="Col3" Style="{StaticResource Chip}" GroupName="Cols" Content="3" Tag="3" Checked="Col_Checked" />
              <TextBox Name="SearchBox" Width="190" Margin="8,0,0,0" Tag="Filtrar sensor…" TextChanged="SearchBox_Changed" />
            </StackPanel>
          </Grid>
          <WrapPanel Name="HardwareFilterPanel" Margin="0,0,0,8" />
          <WrapPanel Name="CategoryFilterPanel" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Row="2" Margin="14,0,14,14" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="GroupsList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding ColumnsCount, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardBorder}" Margin="4,0,4,8" Padding="14,12" VerticalAlignment="Top">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Prefix}" Foreground="{DynamicResource AccentHover}" FontSize="10.5" FontWeight="Bold" />
                      </Border>
                      <TextBlock Text="{Binding Hardware}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="310" />
                    </StackPanel>
                    <Button Style="{StaticResource OutlineButton}" Content="OCULTAR" Padding="8,2" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="{Binding Hardware}" ToolTip="Ocultar este hardware do monitor" Click="HideHardware_Click" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="78" />
                      <ColumnDefinition Width="74" />
                      <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SENSOR" Style="{StaticResource Label}" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="ATUAL" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="MÍN." Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="MÁX." Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,5">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="78" />
                              <ColumnDefinition Width="74" />
                              <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                              <Run Foreground="{DynamicResource Faint}" FontSize="11" Text="{Binding Category, Mode=OneWay}" />
                              <Run Text=" " />
                              <Run Foreground="{DynamicResource Fg}" Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Right" Text="{Binding Value}" />
                            <TextBlock Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Text="{Binding Min}" />
                            <TextBlock Grid.Column="3" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Text="{Binding Max}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
